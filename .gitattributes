# Forzar finales de línea LF en el repositorio y en el checkout, aunque se
# trabaje desde Windows. Evita diffs ruidosos y fallos en los runners Linux
# de GitHub Actions (p. ej. scripts .sh con CRLF no se ejecutan).
*.tf    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
# .terraform.lock.hcl: Terraform lo regenera con LF; si Git lo convirtiera a
# CRLF en Windows, aparecería como modificado sin cambios reales.
*.hcl   text eol=lf
